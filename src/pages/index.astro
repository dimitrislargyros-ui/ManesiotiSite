---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';

const logoMarkSvg = fs.readFileSync(
  path.resolve('src/assets/logo-mark.svg'),
  'utf-8'
);

const sectors = [
  { title: 'Ζωοτροφές', tag: 'Για pet shops και χονδρεμπόρους ζωοτροφών', href: '/proionta/zootrofes/', image: '/images/hero/zootrofes.jpg' },
  { title: 'Μπαχαρικά', tag: 'Για βιομηχανίες τροφίμων και συσκευαστήρια', href: '/proionta/mpaxarika/', image: '/images/hero/mpaxarika.jpg' },
  { title: 'Κασσίτερος – Μόλυβδος', tag: 'Για βιομηχανίες, χυτήρια και μηχανουργεία', href: '/proionta/kassiteros/', image: '/images/hero/kassiteros.jpg' },
];

const brands = [
  { name: 'Teurlings', logo: '/images/brands/teurlings.jpg', url: null },
  { name: 'Avenal', logo: '/images/brands/avenal.png', url: 'https://www.avenal.pt' },
  { name: 'Belize', logo: '/images/brands/belize.png', url: null },
  { name: 'Especial Caza', logo: '/images/brands/especial-caza.jpg', url: null },
  { name: 'Rokus', logo: '/images/brands/rokus.jpg', url: null },
  { name: 'Petnature', logo: '/images/brands/petnature.jpg', url: null },
  { name: 'Woofy', logo: '/images/brands/woofy.jpg', url: null },
];

const stats = [
  { value: 1919, suffix: '', label: 'Έτος ίδρυσης' },
  { value: 100, suffix: '+', label: 'Επιχειρήσεις-πελάτες' },
  { value: 3, suffix: '', label: 'Κλάδοι δραστηριότητας' },
  { value: 200, suffix: '+', label: 'Προϊόντα' },
];
---
<Layout
  title="Αρχική"
  description="Εισαγωγές και χονδρεμπόριο ζωοτροφών, μπαχαρικών και κασσίτερου από το 1919. Παράδοση σε όλη την Αττική, αποστολή σε όλη την Ελλάδα."
>
  <section class="hero">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="hero-mark reveal" set:html={logoMarkSvg} />
      <p class="eyebrow reveal">Από το 1919</p>
      <h1 class="hero-title reveal">Εισαγωγές και χονδρεμπόριο <span>από το 1919</span></h1>
      <p class="hero-lede reveal">
        Ζωοτροφές, μπαχαρικά και κασσίτερος για επαγγελματίες, με παράδοση σε όλη την Αττική και αποστολή σε όλη
        την Ελλάδα.
      </p>
      <div class="hero-actions reveal">
        <a href="/paraggelia/" class="btn btn-primary">Παραγγελία</a>
        <a href="/proionta/" class="hero-link">Δείτε τα προϊόντα <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="stats" aria-label="Στοιχεία εταιρείας">
    <div class="container stats-grid">
      {stats.map((s) => (
        <div class="stat reveal">
          <p class="stat-value" data-count={s.value} data-suffix={s.suffix}>0{s.suffix}</p>
          <p class="stat-label">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sectors container">
    <p class="eyebrow reveal">Τομείς δραστηριότητας</p>
    <div class="sectors-grid">
      {sectors.map((s) => (
        <a href={s.href} class="sector-card reveal">
          <img src={s.image} alt="" class="sector-photo" loading="lazy" width="400" height="300" />
          <div class="sector-card-body">
            <h3>{s.title}</h3>
            <p>{s.tag}</p>
          </div>
          <span class="sector-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="brands container">
    <p class="eyebrow reveal">Brands που διανέμουμε</p>
    <ul class="brands-list reveal">
      {brands.map((b) => (
        <li>
          {b.url ? (
            <a href={b.url} target="_blank" rel="noopener noreferrer" aria-label={`${b.name} — επίσημος ιστότοπος`}>
              <img src={b.logo} alt={b.name} loading="lazy" />
            </a>
          ) : (
            <img src={b.logo} alt={b.name} loading="lazy" />
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="history container">
    <div class="history-grid">
      <div class="history-photos reveal">
        <img
          src="/images/company/building.jpg"
          alt="Η αποθήκη μας στην Αδριανού 11, Πειραιάς, με την επιγραφή Ν.Θ. Μανεσιώτης &amp; Υιός Α.Ε."
          class="history-photo-main"
          loading="lazy"
          width="700"
          height="525"
        />
        <img
          src="/images/company/vintage.png"
          alt="Ιστορική φωτογραφία του αρχικού καταστήματος, «Εν τη εργασία η νίκη»"
          class="history-photo-vintage"
          loading="lazy"
          width="241"
          height="300"
        />
      </div>
      <div class="history-text">
        <div class="reveal">
          <p class="eyebrow">Από το 1919</p>
          <h2>Τρεις γενιές, ένας σκοπός</h2>
        </div>
        <p class="history-copy reveal">
          Ο Νίκος Μανεσιώτης ίδρυσε την εταιρεία στον Πειραιά το 1919, με μπαχαρικά και κασσίτερο. Σήμερα η τρίτη
          γενιά της οικογένειας διευθύνει αποθήκες 1.500 τ.μ. Από το 1988 η εταιρεία ασχολείται και με ζωοτροφές,
          εξυπηρετώντας pet shops και καταστήματα σε όλη την Ελλάδα.
        </p>
        <a href="/etaireia/" class="hero-link reveal">Η ιστορία μας <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="how-we-work container">
    <p class="eyebrow reveal">Πώς δουλεύουμε</p>
    <div class="how-grid">
      <div class="how-card reveal">
        <h3>Παραδόσεις σε όλη την Αττική</h3>
        <p>Με ιδιόκτητα οχήματα παραδίδουμε απευθείας στην επιχείρησή σας. Ελάχιστη παραγγελία και
          προγραμματισμένες διαδρομές για αξιόπιστη εξυπηρέτηση.</p>
      </div>
      <div class="how-card reveal">
        <h3>Αποστολή σε όλη την Ελλάδα</h3>
        <p>Για τα νησιά και την υπόλοιπη Ελλάδα στέλνουμε μέσω μεταφορικών. Επικοινωνήστε για τους χρόνους και
          τα έξοδα αποστολής.</p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band-inner reveal">
      <h2>Μια συνεργασία που συμφέρει</h2>
      <div class="cta-actions">
        <a href="/paraggelia/" class="btn btn-primary">Παραγγελία</a>
        <a href="tel:+302104122132" class="hero-link">210 412 2132</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--s-96) var(--s-64);
  }
  .hero-backdrop {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 140%;
    background:
      radial-gradient(60% 50% at 15% 20%, var(--olive-100) 0%, transparent 60%),
      radial-gradient(50% 40% at 90% 10%, rgba(61, 82, 39, 0.12) 0%, transparent 65%);
    z-index: -1;
  }
  .hero-inner { max-width: 860px; }
  .hero-mark {
    display: block;
    width: 84px;
    height: auto;
    color: var(--olive-700);
    margin-bottom: var(--s-24);
  }
  .hero-mark :global(svg) { display: block; width: 100%; height: auto; }
  .hero-title {
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    margin-block: var(--s-16) var(--s-20);
  }
  .hero-title span { color: var(--olive-700); }
  .hero-lede {
    font-size: 1.1875rem;
    color: var(--tin-700);
    max-width: 52ch;
    margin-bottom: var(--s-32);
  }
  .hero-actions { display: flex; align-items: center; gap: var(--s-24); flex-wrap: wrap; }
  .hero-link {
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: var(--s-8);
    transition: gap var(--duration-hover) var(--ease-out), color var(--duration-hover) var(--ease-out);
  }
  .hero-link:hover { gap: var(--s-12); color: var(--olive-700); }

  .stats { border-block: 1px solid var(--tin-200); padding-block: var(--s-48); margin-top: var(--s-32); }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-32);
    text-align: center;
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw + 1rem, 3.25rem);
    color: var(--olive-700);
    font-variant-numeric: tabular-nums;
  }
  .stat-label { font-size: var(--text-small); color: var(--tin-600); margin-top: var(--s-4); }

  .sectors { padding-block: var(--s-96); }
  .sectors-grid {
    display: grid;
    gap: var(--s-16);
    margin-top: var(--s-24);
  }
  .sector-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--tin-200);
    border-radius: var(--radius-input);
    transition: border-color var(--duration-hover) var(--ease-out);
  }
  .sector-card:hover { border-color: var(--olive-700); }
  .sector-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform var(--duration-focal) var(--ease-out);
  }
  .sector-card:hover .sector-photo { transform: scale(1.04); }
  .sector-card-body { padding: var(--s-24); }
  .sector-card h3 { font-size: var(--text-h3); margin-bottom: var(--s-8); }
  .sector-card p { color: var(--tin-600); font-size: var(--text-small); max-width: 34ch; }
  .sector-arrow {
    position: absolute;
    top: var(--s-16);
    right: var(--s-16);
    font-size: 1.25rem;
    color: var(--paper);
    background: rgba(22, 26, 18, 0.45);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-hover) var(--ease-out);
  }
  .sector-card:hover .sector-arrow { transform: translateX(4px); }

  .brands { padding-block: var(--s-64); }
  .brands-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-40);
    list-style: none;
    padding: 0;
    margin-top: var(--s-24);
  }
  .brands-list img {
    display: block;
    height: 64px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter var(--duration-hover) var(--ease-out), opacity var(--duration-hover) var(--ease-out);
  }
  .brands-list img:hover { filter: grayscale(0); opacity: 1; }

  .history { padding-block: var(--s-64); }
  .history-grid { display: grid; gap: var(--s-32); }
  .history-photos { position: relative; }
  .history-photo-main {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-input);
    object-fit: cover;
  }
  .history-photo-vintage {
    display: none;
    position: absolute;
    bottom: calc(-1 * var(--s-24));
    left: calc(-1 * var(--s-24));
    width: 128px;
    height: auto;
    box-shadow: 0 16px 32px rgba(22, 26, 18, 0.28);
  }
  .history-text { display: grid; gap: var(--s-16); max-width: 760px; }
  .history-grid h2 { font-size: var(--text-h2); margin-top: var(--s-8); }
  .history-copy { color: var(--tin-700); }

  .how-we-work { padding-block: var(--s-64); }
  .how-grid { display: grid; gap: var(--s-16); margin-top: var(--s-24); }
  .how-card { border: 1px solid var(--tin-200); border-radius: var(--radius-input); padding: var(--s-24); }
  .how-card h3 { font-size: var(--text-h3); margin-bottom: var(--s-8); }
  .how-card p { color: var(--tin-600); font-size: var(--text-small); }

  .cta-band { background: var(--ink); color: var(--paper); padding-block: var(--s-64); margin-top: var(--s-32); }
  .cta-band-inner { display: flex; flex-direction: column; gap: var(--s-24); align-items: flex-start; }
  .cta-band h2 { font-size: var(--text-h2); }
  .cta-actions { display: flex; align-items: center; gap: var(--s-24); flex-wrap: wrap; }
  .cta-band .hero-link:hover { color: #8ba877; }

  @media (width >= 700px) {
    .sectors-grid { grid-template-columns: repeat(3, 1fr); }
    .how-grid { grid-template-columns: repeat(2, 1fr); }
    .history-grid { grid-template-columns: 1fr 1fr; align-items: center; }
    .history-photo-vintage { display: block; }
  }
  @media (width >= 640px) {
    .stats-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (width >= 900px) {
    .cta-band-inner { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const statEls = document.querySelectorAll<HTMLElement>('[data-count]');

  function animateCount(el: HTMLElement) {
    const target = Number(el.dataset.count);
    const suffix = el.dataset.suffix ?? '';
    if (reduceMotion) {
      el.textContent = `${target}${suffix}`;
      return;
    }
    const duration = 900;
    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = `${Math.round(target * eased)}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animateCount(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.5 }
  );
  statEls.forEach((el) => io.observe(el));
</script>
