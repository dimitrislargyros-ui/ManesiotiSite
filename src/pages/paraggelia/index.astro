---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Παραγγελία" description="Συμπληρώστε τη φόρμα παραγγελίας και θα επικοινωνήσουμε μαζί σας για επιβεβαίωση και τιμοκατάλογο.">
  <section class="intro container">
    <h1 class="reveal">Παραγγελία</h1>
    <p class="reveal">Συμπληρώστε τη φόρμα και θα επικοινωνήσουμε μαζί σας για επιβεβαίωση και τιμοκατάλογο.</p>
  </section>

  <section class="container form-section">
    <form data-order-form class="order-form">
      <fieldset class="form-block">
        <legend>Ζωοτροφές</legend>
        <div class="search-field">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.3"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          <input type="text" placeholder="Αναζήτηση προϊόντος" aria-label="Αναζήτηση προϊόντος ζωοτροφών" data-product-search autocomplete="off" />
        </div>
        <ul class="search-results" data-search-results hidden></ul>
        <div class="selected-block">
          <p class="detail-label">Επιλεγμένα προϊόντα</p>
          <p class="empty-note" data-selected-empty>Δεν έχετε επιλέξει προϊόντα ακόμα.</p>
          <ul class="selected-list" data-selected-list></ul>
        </div>
      </fieldset>

      <fieldset class="form-block">
        <legend>Μπαχαρικά <span class="optional">(προαιρετικό)</span></legend>
        <textarea name="mpaxarika" rows="3" placeholder="π.χ. Μαύρο πιπέρι 5kg, Κανέλλα ξύλο 8cm…"></textarea>
      </fieldset>

      <fieldset class="form-block">
        <legend>Κασσίτερος / Μόλυβδος / Κολλήσεις <span class="optional">(προαιρετικό)</span></legend>
        <textarea name="kassiteros" rows="3" placeholder="π.χ. Κασσίτερος βέργα 99,9%…"></textarea>
      </fieldset>

      <fieldset class="form-block">
        <legend>Στοιχεία επικοινωνίας</legend>
        <div class="field-grid">
          <label class="field">
            <span>Επωνυμία <span class="required">*</span></span>
            <input type="text" name="company" required />
          </label>
          <label class="field">
            <span>Ονοματεπώνυμο <span class="required">*</span></span>
            <input type="text" name="fullname" required />
          </label>
          <label class="field">
            <span>Τηλέφωνο <span class="required">*</span></span>
            <input type="tel" name="phone" required />
          </label>
          <label class="field">
            <span>Email <span class="required">*</span></span>
            <input type="email" name="email" required />
          </label>
          <label class="field">
            <span>ΑΦΜ <span class="optional">(προαιρετικό)</span></span>
            <input type="text" name="vat" />
          </label>
          <label class="field">
            <span>Περιοχή παράδοσης <span class="optional">(προαιρετικό)</span></span>
            <input type="text" name="area" />
          </label>
        </div>
        <label class="field field-full">
          <span>Σχόλια <span class="optional">(προαιρετικό)</span></span>
          <textarea name="comments" rows="3"></textarea>
        </label>
      </fieldset>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Αποστολή παραγγελίας</button>
        <p class="prefer-phone">Προτιμάτε τηλέφωνο; <a href="tel:+302104122132">210 412 2132</a></p>
      </div>
    </form>

    <div class="success-panel" data-success hidden>
      <h2>Η παραγγελία σας στάλθηκε!</h2>
      <p>Θα επικοινωνήσουμε μαζί σας σύντομα για επιβεβαίωση και τιμοκατάλογο. Μπορείτε επίσης να μας καλέσετε στο <a href="tel:+302104122132">210 412 2132</a>.</p>
      <a href="/" class="btn btn-secondary">Αρχική σελίδα</a>
    </div>
  </section>
</Layout>

<style>
  .intro { padding-block: var(--s-64) var(--s-32); max-width: 680px; }
  .intro h1 { font-size: var(--text-h2); margin-bottom: var(--s-12); }
  .intro p { color: var(--tin-700); }

  .form-section { padding-bottom: var(--s-96); max-width: 720px; }

  .order-form { display: flex; flex-direction: column; gap: var(--s-32); }
  .form-block { border: 1px solid var(--tin-200); border-radius: var(--radius-input); padding: var(--s-24); }
  .form-block legend {
    font-size: var(--text-label);
    font-weight: 600;
    padding: 0 var(--s-8);
  }
  .optional, .required { font-weight: 400; color: var(--tin-500); font-size: var(--text-small); }
  .required { color: var(--olive-700); }

  .search-field {
    display: flex;
    align-items: center;
    gap: var(--s-8);
    border: 1px solid var(--tin-300);
    border-radius: var(--radius-input);
    padding: var(--s-12) var(--s-16);
  }
  .search-field svg { color: var(--tin-500); flex-shrink: 0; }
  .search-field input { border: none; outline: none; width: 100%; font-size: var(--text-body); }

  .search-results {
    list-style: none;
    margin-top: var(--s-8);
    border: 1px solid var(--tin-200);
    border-radius: var(--radius-input);
    max-height: 220px;
    overflow-y: auto;
  }
  .search-results li {
    padding: var(--s-8) var(--s-12);
    cursor: pointer;
    font-size: var(--text-small);
    border-bottom: 1px solid var(--tin-100);
  }
  .search-results li:last-child { border-bottom: none; }
  .search-results li:hover { background: var(--olive-100); }

  .selected-block { margin-top: var(--s-16); }
  .detail-label { font-size: var(--text-small); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--tin-500); margin-bottom: var(--s-8); }
  .empty-note { color: var(--tin-500); font-size: var(--text-small); }
  .selected-list { list-style: none; display: flex; flex-direction: column; gap: var(--s-8); }
  .selected-list li {
    display: flex;
    align-items: center;
    gap: var(--s-12);
    background: var(--olive-100);
    color: var(--olive-800);
    border-radius: var(--radius-input);
    padding: var(--s-8) var(--s-8) var(--s-8) var(--s-12);
    font-size: var(--text-small);
  }
  .selected-name { flex: 1; min-width: 0; }
  .selected-stepper {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    background: var(--surface);
    border-radius: var(--radius-button);
    padding: var(--s-4);
    flex-shrink: 0;
  }
  .selected-stepper button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    border-radius: var(--radius-button);
    color: var(--olive-800);
  }
  .selected-stepper button:hover { background: var(--olive-100); }
  .selected-stepper span { min-width: 1.5ch; text-align: center; font-weight: 700; }
  .selected-remove {
    flex-shrink: 0;
    background: none;
    border: none;
    color: inherit;
    opacity: 0.7;
    padding: var(--s-4);
  }
  .selected-remove:hover { opacity: 1; }

  textarea, input[type="text"], input[type="tel"], input[type="email"] {
    width: 100%;
    border: 1px solid var(--tin-300);
    border-radius: var(--radius-input);
    padding: var(--s-12);
    resize: vertical;
  }

  .field-grid { display: grid; gap: var(--s-16); margin-bottom: var(--s-16); }
  .field { display: flex; flex-direction: column; gap: var(--s-4); font-size: var(--text-small); }
  .field-full { margin-top: 0; }

  .form-actions { display: flex; flex-direction: column; gap: var(--s-12); align-items: flex-start; }
  .prefer-phone { font-size: var(--text-small); color: var(--tin-600); }
  .prefer-phone a { font-weight: 600; color: var(--olive-700); }

  .success-panel {
    border: 1px solid var(--tin-200);
    border-radius: var(--radius-input);
    padding: var(--s-48) var(--s-32);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-16);
  }
  .success-panel h2 { font-size: var(--text-h3); }
  .success-panel p { color: var(--tin-700); max-width: 48ch; }

  @media (width >= 600px) {
    .field-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  import { products } from '../../data/zootrofes-products';
  import { getCart, addToCart, changeQty, removeFromCart, clearCart, CART_EVENT } from '../../lib/cart';

  const searchInput = document.querySelector<HTMLInputElement>('[data-product-search]');
  const resultsList = document.querySelector<HTMLElement>('[data-search-results]');
  const selectedList = document.querySelector<HTMLElement>('[data-selected-list]');
  const selectedEmpty = document.querySelector<HTMLElement>('[data-selected-empty]');
  const form = document.querySelector<HTMLFormElement>('[data-order-form]');
  const successPanel = document.querySelector<HTMLElement>('[data-success]');

  // Selection lives in the shared cart store (src/lib/cart.ts) so products
  // added from the catalog page (/proionta/zootrofes/) show up here too.
  function renderSelected() {
    if (!selectedList || !selectedEmpty) return;
    const selected = getCart();
    selectedList.innerHTML = '';
    selectedEmpty.hidden = selected.length > 0;
    for (const item of selected) {
      const li = document.createElement('li');

      const name = document.createElement('span');
      name.className = 'selected-name';
      name.textContent = item.brand ? `${item.name} — ${item.brand}` : item.name;
      li.appendChild(name);

      const stepper = document.createElement('span');
      stepper.className = 'selected-stepper';

      const dec = document.createElement('button');
      dec.type = 'button';
      dec.setAttribute('aria-label', `Λιγότερα ${item.name}`);
      dec.textContent = '−';
      dec.addEventListener('click', () => changeQty(item, -1));

      const qty = document.createElement('span');
      qty.textContent = String(item.qty);

      const inc = document.createElement('button');
      inc.type = 'button';
      inc.setAttribute('aria-label', `Περισσότερα ${item.name}`);
      inc.textContent = '+';
      inc.addEventListener('click', () => changeQty(item, 1));

      stepper.append(dec, qty, inc);
      li.appendChild(stepper);

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'selected-remove';
      remove.setAttribute('aria-label', `Αφαίρεση ${item.name}`);
      remove.innerHTML = '×';
      remove.addEventListener('click', () => removeFromCart(item.code));
      li.appendChild(remove);

      selectedList.appendChild(li);
    }
  }

  window.addEventListener(CART_EVENT, renderSelected);

  searchInput?.addEventListener('input', () => {
    const term = searchInput.value.trim().toLowerCase();
    if (!resultsList) return;
    if (!term) {
      resultsList.hidden = true;
      resultsList.innerHTML = '';
      return;
    }
    const matches = products
      .filter((p) => p.name.toLowerCase().includes(term) || (p.brand ?? '').toLowerCase().includes(term))
      .slice(0, 8);
    resultsList.innerHTML = '';
    resultsList.hidden = matches.length === 0;
    for (const p of matches) {
      const li = document.createElement('li');
      li.textContent = p.brand ? `${p.name} — ${p.brand}` : p.name;
      li.addEventListener('click', () => {
        addToCart({ code: p.code, name: p.name, brand: p.brand });
        searchInput.value = '';
        resultsList.hidden = true;
        resultsList.innerHTML = '';
      });
      resultsList.appendChild(li);
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // No backend endpoint exists yet for this form — wire up a real submission
    // handler (API route / email service) before launch. For now this just
    // shows the confirmation state and clears the shared cart.
    clearCart();
    form.hidden = true;
    if (successPanel) successPanel.hidden = false;
  });

  renderSelected();
</script>
