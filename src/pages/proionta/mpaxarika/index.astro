---
import Layout from '../../../layouts/Layout.astro';

const spicePhotos: Record<string, string> = {
  'Μαύρο πιπέρι': '/images/mpaxarika/black-pepper.jpg',
  'Τσίλι': '/images/mpaxarika/chili.jpg',
  'Πράσινο πιπέρι': '/images/mpaxarika/green-pepper.jpg',
  'Ροζ πιπέρι': '/images/mpaxarika/rose-pepper.jpg',
  'Κανέλλα ξύλο 8cm': '/images/mpaxarika/cinnamon.jpg',
};

const groups = [
  { title: 'Πιπέρια', items: ['Μαύρο πιπέρι', 'Λευκό πιπέρι', 'Κόκκινο πιπέρι', 'Τσίλι', 'Πράσινο πιπέρι', 'Ροζ πιπέρι'] },
  { title: 'Αρωματικά', items: ['Γλυκάνισος', 'Γαρύφαλλα', 'Μπαχάρι', 'Κύμινο', 'Κάρρυ', 'Κανέλλα ξύλο 8cm', 'Λιβάνι χονδρό'] },
  { title: 'Λοιπά', items: ['Τσάι κανάρυ 1kg', 'Κιτρικό οξύ'] },
];
---
<Layout title="Μπαχαρικά" description="Εισαγωγές μπαχαρικών από πιστοποιημένους προμηθευτές. Χονδρική για βιομηχανίες τροφίμων, συσκευαστήρια και καταστήματα.">
  <section class="intro container">
    <div class="intro-grid">
      <div class="reveal">
        <p class="eyebrow">Προϊόντα</p>
        <h1>Μπαχαρικά</h1>
        <p>
          Εισαγωγές από πιστοποιημένους προμηθευτές. Αποθήκευση σε κατάλληλες συνθήκες υγρασίας και θερμοκρασίας
          στις αποθήκες μας στον Πειραιά. Εξυπηρετούμε βιομηχανίες τροφίμων, συσκευαστήρια και καταστήματα.
        </p>
      </div>
      <img src="/images/mpaxarika/hero-detail.jpg" alt="Μπαχαρικά Μανεσιώτης" class="intro-photo reveal" loading="lazy" width="700" height="467" />
    </div>
  </section>

  <section class="container groups">
    <p class="eyebrow reveal">Διαθέσιμα είδη</p>
    <div class="groups-grid">
      {groups.map((g) => (
        <div class="group-card reveal">
          <h2>{g.title}</h2>
          <ul>
            {g.items.map((item) => (
              <li>
                {spicePhotos[item] && <img src={spicePhotos[item]} alt="" loading="lazy" width="36" height="36" />}
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container quote-cta reveal">
    <h2>Ζητήστε προσφορά</h2>
    <p>
      Για τιμές και διαθεσιμότητα, επικοινωνήστε μαζί μας τηλεφωνικά ή μέσω της φόρμας. Διαθέτουμε επίσης ατομική
      συσκευασία τσαγιού καναρίου (1 kg).
    </p>
    <div class="quote-cta-actions">
      <a href="/paraggelia/" class="btn btn-primary">Παραγγελία</a>
      <a href="tel:+302104122132" class="hero-link">210 412 2132</a>
    </div>
  </section>
</Layout>

<style>
  .intro { padding-block: var(--s-64) var(--s-32); }
  .intro-grid { display: grid; gap: var(--s-32); max-width: 1000px; }
  .intro h1 { font-size: var(--text-h2); margin-block: var(--s-8) var(--s-12); }
  .intro p { color: var(--tin-700); }
  .intro-photo { width: 100%; height: auto; border-radius: var(--radius-input); object-fit: cover; }

  .groups { padding-block: var(--s-32) var(--s-64); }
  .groups-grid { display: grid; gap: var(--s-16); margin-top: var(--s-24); }
  .group-card { border: 1px solid var(--tin-200); border-radius: var(--radius-input); padding: var(--s-24); }
  .group-card h2 { font-size: var(--text-h3); margin-bottom: var(--s-12); }
  .group-card ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--s-8); }
  .group-card li { display: flex; align-items: center; gap: var(--s-12); font-size: var(--text-label); color: var(--tin-700); padding-bottom: var(--s-8); border-bottom: 1px solid var(--tin-100); }
  .group-card li:last-child { border-bottom: none; padding-bottom: 0; }
  .group-card li img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }

  @media (width >= 700px) {
    .intro-grid { grid-template-columns: 1fr 1fr; align-items: center; }
  }

  .quote-cta { border-top: 1px solid var(--tin-200); padding-block: var(--s-48); max-width: 640px; }
  .quote-cta h2 { font-size: var(--text-h3); margin-bottom: var(--s-12); }
  .quote-cta p { color: var(--tin-700); margin-bottom: var(--s-24); }
  .quote-cta-actions { display: flex; align-items: center; gap: var(--s-24); }
  .hero-link { font-weight: 600; color: var(--olive-700); }

  @media (width >= 700px) {
    .groups-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
